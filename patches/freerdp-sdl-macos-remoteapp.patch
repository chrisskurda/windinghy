+/* WinDinghy: the server shows a logon notice (legal banner etc.) that needs the user. Announce it
+ * on the log so the launcher can show its own dialog; when the launcher accepts it signals
+ * SIGUSR1 and we dismiss the Windows dialog once with Enter. */
+static std::atomic<bool> g_noticeAccepted{ false };
+static std::atomic<bool> g_noticeWatching{ false };
+
+static void windinghyAcceptSignal(int)
+{
+	g_noticeAccepted = true;
+}
+
+void SdlRail::announceLogonNotice()
+{
+	WLog_WARN(TAG, "WINDINGHY-LOGON-NOTICE");
+	if (g_noticeWatching.exchange(true))
+		return;
+	std::signal(SIGUSR1, windinghyAcceptSignal);
+	rdpInput* input = _context->context()->input;
+	std::thread([input]() {
+		for (int i = 0; i < 1200 && !g_noticeAccepted; i++)
+			std::this_thread::sleep_for(std::chrono::milliseconds(100));
+		if (!g_noticeAccepted)
+			return;
+		std::this_thread::sleep_for(std::chrono::milliseconds(300));
+		(void)freerdp_input_send_keyboard_event_ex(input, TRUE, FALSE, RDP_SCANCODE_RETURN);
+		(void)freerdp_input_send_keyboard_event_ex(input, FALSE, FALSE, RDP_SCANCODE_RETURN);
+	}).detach();
+}
+
 /* Show the desktop anyway after this: not every logon prompt is announced. */
