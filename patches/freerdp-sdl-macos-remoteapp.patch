+/* WinDinghy: drives named in WINDINGHY_RO_DRIVES (comma separated) are served read-only. */
+static BOOL drive_name_is_read_only(const char* name)
+{
+	const char* env = getenv("WINDINGHY_RO_DRIVES");
+	if (!env || !name)
+		return FALSE;
+	const size_t n = strlen(name);
+	const char* p = env;
+	while (*p)
+	{
+		const char* e = strchr(p, ',');
+		const size_t len = e ? (size_t)(e - p) : strlen(p);
+		if (len == n && _strnicmp(p, name, n) == 0)
+			return TRUE;
+		if (!e)
+			break;
+		p = e + 1;
+	}
+	return FALSE;
+}
